# Local development only: where `yarn dev` finds the FastAPI backend
# (cd ../resource-backend && uvicorn app.main:app --port 8082).
# Both default to these values when unset.
VITE_PLUGIN_API_URL=http://localhost
VITE_PLUGIN_API_PORT=8082

# Optional, for a build with NO backend (GitHub Pages): serve the imaging
# catalogue from a copy instead of the backend. Absolute URLs are used
# verbatim; a root-relative one is resolved against the app's base (that is
# how the GitHub Pages build points at its copy). Setting it also leaves out
# the pages that need the backend (My MRI): see `hasBackend()` in
# src/runtime/env.ts.
# VITE_ASSET_BASE=/modelView/
